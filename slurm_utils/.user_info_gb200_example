# =============================================================================
# GB200 — per-user settings only (EXAMPLE)
# =============================================================================
#   cp .user_info_gb200_example .user_info_gb200
#
# Do NOT duplicate settings from .ipd/.env.gb200 here:
#   DATA_PATH, SQUASHFS_MOUNTS, CONTAINER_MOUNTS, CLUSTER, REMOTE, tool paths, …
# =============================================================================

USER="${USER:-your_username}"
ACCOUNT="your_account"
SKIP_ACCOUNT="false"

ROOT_REMOTE="/path/to/shared/storage"
LOCAL_CODE_DIR="/path/to/shared/storage"

# Container image — only defined here (ARM64 squash or registry URL)
CONTAINER_IMAGE="/path/to/shared/storage"

WANDBKEY=""

PARTITION="batch"
GPUS_PER_NODE_CLUSTER=4
RUNTIME="04:00:00"
SIGNAL_TIME=600
GPU_TYPE="B200"
EXCLUDE_NODES=""
SLURM_EXTRA_OPTIONS=""
EXTRA_CONTAINER_MOUNTS=""
USE_CUEQUIVARIANCE=""

ENV_VARS=(
    "TORCHINDUCTOR_CACHE_DIR=/path/to/shared/storage"
)
