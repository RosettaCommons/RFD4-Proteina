USER="${USER:-your_username}"
ACCOUNT="your_account"
SKIP_ACCOUNT="false"

ROOT_REMOTE="/lustre/fsw/portfolios/nvr/users/${USER}/runs"
LOCAL_CODE_DIR="/lustre/fsw/portfolios/nvr/users/${USER}/projects/foundry-dev"

# Container image — only defined here (ARM64 squash or registry URL)
CONTAINER_IMAGE="/lustre/fsw/portfolios/nvr/users/${USER}/PFM_data/squash_images/latent-dev-arm64.sqsh"

WANDBKEY=""

PARTITION="batch"
GPUS_PER_NODE_CLUSTER=4
RUNTIME="04:00:00"
SIGNAL_TIME=600
GPU_TYPE="B200"
EXCLUDE_NODES=""
SLURM_EXTRA_OPTIONS=""
EXTRA_CONTAINER_MOUNTS=""
USE_CUEQUIVARIANCE=""

ENV_VARS=(
    "TORCHINDUCTOR_CACHE_DIR=/lustre/fsw/portfolios/nvr/users/${USER}/.cache/torchinductor"
)
