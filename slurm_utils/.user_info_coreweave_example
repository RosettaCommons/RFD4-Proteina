# =============================================================================
# CoreWeave — per-user settings only (EXAMPLE)
# =============================================================================
#   cp .user_info_coreweave_example .user_info_coreweave
#
# Do NOT duplicate settings from .ipd/.env.coreweave here:
#   DATA_PATH, SQUASHFS_MOUNTS, LATENT_APPTAINER_SIF, CLUSTER, tool paths, …
# =============================================================================

USER="${USER:-your_username}"
SKIP_ACCOUNT="true"

ROOT_REMOTE="/path/to/user-data/${USER}/PFM_runs"

WANDBKEY=""

PARTITION="hpc-high"
RUNTIME="03-00:00:00"
SIGNAL_TIME=600
MEM=0
GPU_TYPE="H200"
EXCLUDE_NODES=""
SLURM_EXTRA_OPTIONS=""
USE_CUEQUIVARIANCE=""

# Apptainer jobs use LATENT_APPTAINER_SIF from .ipd/.env.coreweave (no CONTAINER_IMAGE).
