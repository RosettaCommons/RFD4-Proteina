# =============================================================================
# CoreWeave Cluster Configuration - EXAMPLE
# =============================================================================
# Copy this file to .user_info_coreweave and fill in your values:
#   cp .user_info_coreweave_example .user_info_coreweave
#
# CoreWeave uses Apptainer containers. Shared data paths, SIF paths, and
# settings live in .ipd/.env.coreweave (committed to git). Only user-specific
# and SLURM settings belong here.
#
# Prereq: add to ~/.bashrc or ~/.zshrc:
#   export CLUSTER=coreweave
#   export CONTAINER_TYPE=apptainer
#
# FAQ: How is this different than .ipd/.env.coreweave?
# .ipd/.env.coreweave is committed to git and contains shared data paths, SIF
# paths, and settings. .user_info_coreweave is not committed to git and contains
# user-specific and/or project-specific SLURM settings. Functionally they both
# provide environment variables that are loaded during run time, but in order to
# share things properly between users and clusters, we split them into two files.
# =============================================================================

# Source shared cluster environment (data paths, SIF paths, etc.)
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_REPO_ROOT="$(cd "$_SCRIPT_DIR/../../.." && pwd)"
if [ -f "$_REPO_ROOT/.ipd/.env.coreweave" ]; then
    set -a
    source "$_REPO_ROOT/.ipd/.env.coreweave"
    set +a
fi
unset _SCRIPT_DIR _REPO_ROOT

# =============================================================================
# Cluster identity
# =============================================================================
# Propagated by SLURM to the job; read by exec_core.sh to source .ipd/.env.${CLUSTER}
CLUSTER=coreweave
CONTAINER_TYPE=apptainer

# =============================================================================
# Cluster-specific settings
# =============================================================================

# Cluster identification for launch script logic
CLUSTER_TYPE="coreweave"
SKIP_ACCOUNT="true"

# Your username on the cluster
USER="${USER:-your_username}"

# Root directory on remote for runs
ROOT_REMOTE="/path/to/user-data/${USER}/PFM_runs"

# Weights & Biases API key (get from https://wandb.ai/authorize)
WANDBKEY=""

# Slurm configuration
PARTITION="hpc-high"
RUNTIME="03-00:00:00"
SIGNAL_TIME=600

# GPU type on this cluster
GPU_TYPE="H200"

# Nodes to exclude (optional)
EXCLUDE_NODES=""

# CoreWeave sets TRES per-task automatically; setting --cpus-per-task conflicts
SKIP_CPUS_PER_TASK="true"

# Extra SLURM options (optional)
SLURM_EXTRA_OPTIONS=""

# cuEquivariance (leave empty for default behavior)
USE_CUEQUIVARIANCE=""

# Note: no CONTAINER_IMAGE needed — the apptainer SIF path (LATENT_APPTAINER_SIF)
# comes from .ipd/.env.coreweave and is read by exec_core.sh via the shebang.
