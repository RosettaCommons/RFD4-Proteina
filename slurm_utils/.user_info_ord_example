# =============================================================================
# ORD — per-user settings only (EXAMPLE)
# =============================================================================
#   cp .user_info_ord_example .user_info_ord
#
# Do NOT duplicate settings from .ipd/.env.ord here:
#   DATA_PATH, SQUASHFS_MOUNTS, CONTAINER_MOUNTS, CLUSTER, REMOTE, tool paths, …
#
# .ipd/.env.ord  → shared cluster topology (committed / team branch)
# .user_info_ord → your account, secrets, container choice, SLURM preferences
# =============================================================================

USER="${USER:-your_username}"
ACCOUNT="your_account"
SKIP_ACCOUNT="false"

ROOT_REMOTE="/path/to/shared/storage"
LOCAL_CODE_DIR="/path/to/shared/storage"

# Container image — only defined here
# Local squash:  .../PFM_data/squash_images/latent-dev-amd64.sqsh
# Registry:       registry.example.com:5005/genair/protein-foundation-models/latent-dev-v26_01:latest
CONTAINER_IMAGE="/path/to/shared/storage"

WANDBKEY=""

PARTITION="grizzly,polar3,polar4"
CPU_PARTITION="cpu_short"
RUNTIME="04:00:00"
SIGNAL_TIME=600
MEM=""
GPU_TYPE="H100"
EXCLUDE_NODES=""
SLURM_EXTRA_OPTIONS=""
EXTRA_CONTAINER_MOUNTS=""

ENV_VARS=(
    "TORCHINDUCTOR_CACHE_DIR=/path/to/shared/storage"
)

# MPNN (optional — see launch_mpnn.sh)
MPNN_PARTITION="cpu"
MPNN_TIME="1:00:00"
MPNN_CPUS=1
MPNN_MEM="16G"
MPNN_SCRIPT_PATH=""
MPNN_CONTAINER_IMAGE=""
MPNN_CONTAINER_MOUNTS=""
