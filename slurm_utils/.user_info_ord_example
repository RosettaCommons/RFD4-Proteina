# =============================================================================
# ORD (OCI) Cluster Configuration - EXAMPLE
# =============================================================================
# Copy this file to .user_info_ord and fill in your values:
#   cp .user_info_ord_example .user_info_ord
#
# OCI clusters use Docker squash images via srun --container-image
# Requires ACCOUNT for SLURM submissions
# =============================================================================

# Cluster identity
CLUSTER=ord
SKIP_ACCOUNT="false"

# Remote cluster login node
REMOTE="cs-oci-ord-login-01.nvidia.com"

# Your username on the cluster
USER="${USER:-your_username}"

# Slurm account for billing
ACCOUNT="your_account"

# Root directory on remote for runs
ROOT_REMOTE="/lustre/fsw/portfolios/nvr/users/${USER}/runs"

# Local code directory path (for from_local scripts)
LOCAL_CODE_DIR="/lustre/fsw/portfolios/nvr/users/${USER}/projects/foundry-dev"

# Data paths
DATA_PATH="/lustre/fsw/portfolios/nvr/users/${USER}/PFM_data"
CACHE_DIR="/lustre/fsw/portfolios/nvr/users/${USER}/PFM_data/cache"
PDB_MIRROR_PATH="/lustre/fsw/portfolios/nvr/users/${USER}/PFM_data/pdb_mirror"
CCD_MIRROR_PATH="/lustre/fsw/portfolios/nvr/users/${USER}/PFM_data/ccd_mirror"

# Container image path (Docker .sqsh file for OCI clusters)
CONTAINER_IMAGE="/lustre/fsw/portfolios/nvr/users/${USER}/PFM_data/squash_images/latent-dev-amd64.sqsh"

# Executables (used inside container)
PYTHON="python"
FOLDSEEK_REMOTE="/usr/local/bin/foldseek"

# Tool paths (for metrics and design tasks)
HBPLUS_PATH=""
MOLPROBITY_PATH=""
MACE_MODEL_PATH=""

# MSA directories (optional, comma-separated paths for multiple directories)
# If set, MSA features will be loaded and used for training
PROTEIN_MSA_DIRS=""
RNA_MSA_DIRS=""

# Weights & Biases API key (get from https://wandb.ai/authorize)
WANDBKEY=""

# Slurm configuration
PARTITION="grizzly,polar3,polar4"
GPUS_PER_NODE_CLUSTER=8
RUNTIME="04:00:00"
SIGNAL_TIME=600

# GPU type on this cluster
GPU_TYPE="A100"

# Nodes to exclude (optional)
EXCLUDE_NODES=""

# Extra SLURM options (optional)
SLURM_EXTRA_OPTIONS=""

# Extra container mounts (comma-separated paths for Docker --container-mounts)
# Format: "/host/path:/container/path:rw,/host/path2:/container/path2:ro"
EXTRA_CONTAINER_MOUNTS=""

# Dataset squashfs mounts (semicolon-separated squash:mountpoint pairs)
# Used by container-based launch scripts (launch_train_latents.sh)
# These are mounted using squashfuse on each task before the job runs
# Format: "/path/to/dataset1.sqsh:/mount/point1;/path/to/dataset2.sqsh:/mount/point2"
# Example: DATASET_SQUASH_MOUNTS="/data/pdb.sqsh:/mnt/pdb;/data/afdb.sqsh:/mnt/afdb"
DATASET_SQUASH_MOUNTS=""

# =============================================================================
# Squashfs Dataset Mounting for Direct (no-container) runs
# =============================================================================
# Used by launch_train_latents_direct.sh
# Set USE_SQUASH_MOUNT="true" to enable per-task squashfs mounting via squashfuse
# This requires FUSE to be available on the cluster nodes
# If FUSE is not available, training will continue but may fail if data isn't pre-mounted
#
# USE_SQUASH_MOUNT="false"
# SQUASH_FILE="/lustre/fsw/portfolios/nvr/users/${USER}/PFM_data/dataset.sqfs"
# MOUNT_POINT="/lustre/fsw/portfolios/nvr/users/${USER}/PFM_data/dataset_mounted"

# cuEquivariance (leave empty for default behavior)
USE_CUEQUIVARIANCE=""

# =============================================================================
# MPNN Settings (for launch_mpnn.sh)
# =============================================================================
# These settings are used by launch_mpnn.sh for running ProteinMPNN/LigandMPNN
# MPNN runs quickly on CPU nodes, no GPU required.
#
# REQUIRED settings (launch_mpnn.sh will error if not set):
#   MPNN_SCRIPT_PATH      - Path to the fused_mpnn run.py script
#   MPNN_CONTAINER_IMAGE  - Container image for running MPNN

# SLURM settings for MPNN jobs
MPNN_PARTITION="cpu"
MPNN_TIME="1:00:00"
MPNN_CPUS=1
MPNN_MEM="16G"

# REQUIRED: Path to the fused_mpnn run script (inside container)
MPNN_SCRIPT_PATH="/path/to/fused_mpnn/run.py"

# REQUIRED: Container image for MPNN
MPNN_CONTAINER_IMAGE=""

# Optional: Container mounts
MPNN_CONTAINER_MOUNTS=""

