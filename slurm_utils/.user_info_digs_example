# =============================================================================
# DIGS — per-user settings only (EXAMPLE)
# =============================================================================
#   cp .user_info_digs_example .user_info_digs
#
# load_user_info() sources .ipd/.env.digs first, then this file.
# Do NOT duplicate shared paths, SIF paths, or NCCL settings from .env.digs.
# =============================================================================

USER="${USER:-your_username}"
SKIP_ACCOUNT="true"

ROOT_REMOTE="/path/to/shared/storage"

WANDBKEY=""

PARTITION="gpu"
RUNTIME="12:00:00"
CPUS_PER_TASK=4
SIGNAL_TIME=600
MEM=30G

# GPU type on this cluster (used for training only)
GPU_TYPE="L40"
EXCLUDE_NODES=""
SLURM_EXTRA_OPTIONS=""
USE_CUEQUIVARIANCE=""

# MPNN (optional — see launch_mpnn.sh)
MPNN_PARTITION="cpu"
MPNN_TIME="1:00:00"
MPNN_CPUS=1
MPNN_MEM="16G"
MPNN_SCRIPT_PATH="/path/to/shared/storage"
MPNN_CONTAINER_IMAGE="/path/to/data"
MPNN_CONTAINER_BINDS="--bind /databases:/databases --bind /path/to/shared/storage:/path/to/shared/storage --bind /projects:/projects --bind /home:/home"
