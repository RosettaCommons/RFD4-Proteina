# =============================================================================
# DIGS Cluster Configuration - EXAMPLE
# =============================================================================
# Copy this file to .user_info_digs and fill in your values:
#   cp .user_info_digs_example .user_info_digs
#
# DIGS uses Apptainer containers. Shared data paths, SIF paths, and NCCL
# settings live in .ipd/.env.digs (committed to git). Only user-specific
# and SLURM settings belong here.
#
# Prereq: add to ~/.bashrc or ~/.zshrc:
#   export CLUSTER=digs
#   export CONTAINER_TYPE=apptainer
#
# FAQ: How is this different than .ipd/.env.digs?
# .ipd/.env.digs is committed to git and contains shared data paths, SIF
# paths, and settings. .user_info_digs is not committed to git and contains
# user-specific and/or project-specific SLURM settings. Functionally they both
# provide environment variables that are loaded during run time, but in order to
# share things properly between users and clusters, we split them into two files.
# =============================================================================

# Source shared cluster environment (data paths, SIF paths, NCCL settings, etc.)
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_REPO_ROOT="$(cd "$_SCRIPT_DIR/../../.." && pwd)"
if [ -f "$_REPO_ROOT/.ipd/.env.digs" ]; then
    set -a
    source "$_REPO_ROOT/.ipd/.env.digs"
    set +a
fi
unset _SCRIPT_DIR _REPO_ROOT

# =============================================================================
# Cluster identity
# =============================================================================
# Propagated by SLURM to the job; read by exec_core.sh to source .ipd/.env.${CLUSTER}
CLUSTER=digs
CONTAINER_TYPE=apptainer

# =============================================================================
# Cluster-specific settings
# =============================================================================

SKIP_ACCOUNT="true"

# Remote cluster login node
REMOTE="<login-host>"

# Your username on the cluster
USER="${USER:-your_username}"

# Root directory on remote for runs
ROOT_REMOTE="/path/to/shared/storage"

# Weights & Biases API key (optional, get from https://wandb.ai/authorize)
WANDBKEY=""

# Slurm configuration
PARTITION="gpu"
RUNTIME="12:00:00"
CPUS_PER_TASK=4
SIGNAL_TIME=600

# GPU type on this cluster (used for training only)
GPU_TYPE="L40"

# Nodes to exclude (optional)
EXCLUDE_NODES=""

# Extra SLURM options (optional)
SLURM_EXTRA_OPTIONS=""

# cuEquivariance (leave empty for default behavior)
USE_CUEQUIVARIANCE=""

# =============================================================================
# MPNN Settings (for launch_mpnn.sh)
# =============================================================================
# These settings are used by launch_mpnn.sh for running ProteinMPNN/LigandMPNN
# MPNN runs quickly on CPU nodes, no GPU required.
#
# REQUIRED settings (launch_mpnn.sh will error if not set):
#   MPNN_SCRIPT_PATH      - Path to the fused_mpnn run.py script
#   MPNN_CONTAINER_IMAGE  - Container image for running MPNN

# SLURM settings for MPNN jobs (optional, these are the defaults)
MPNN_PARTITION="cpu"
MPNN_TIME="1:00:00"
MPNN_CPUS=1
MPNN_MEM="16G"

# REQUIRED: Path to the mpnn run script
MPNN_SCRIPT_PATH="/path/to/shared/storage"

# REQUIRED: Container image for MPNN
# For DIGS (Apptainer): path to .sif file
MPNN_CONTAINER_IMAGE="/path/to/data"

# Optional: Apptainer bind mounts
MPNN_CONTAINER_BINDS="--bind /databases:/databases --bind /path/to/shared/storage:/path/to/shared/storage --bind /projects:/projects --bind /home:/home"
