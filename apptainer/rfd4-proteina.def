# RFD4-Proteina Apptainer/Singularity image: the same build as the Dockerfile, for clusters without Docker.
#
# Build from the repository root; ACCELERATOR selects the CUDA stack (cu13 is the default):
#   apptainer build rfd4-proteina-cu13.sif apptainer/rfd4-proteina.def
#   apptainer build --build-arg ACCELERATOR=cu12 rfd4-proteina-cu12.sif apptainer/rfd4-proteina.def
#   apptainer build --build-arg ACCELERATOR=cpu  rfd4-proteina-cpu.sif  apptainer/rfd4-proteina.def
#
# ACCELERATOR picks the extra and the Torch wheel index:
#   cu13 -> .[all-cuda13], Torch cu130, tmol-ops-cu13, BioIR
#   cu12 -> .[all-cuda12], Torch cu126, tmol-ops-cu12
#   cpu  -> no extra,      Torch cpu,   TMol CPU operators
#
# Run with the host driver and a writable Hugging Face cache:
#   apptainer run --nv rfd4-proteina-cu13.sif rfd4-generate hf_ckpt_path=nvidia/RFD4-Proteina inputs=... out_dir=...
#
# Everything installs from public PyPI and the public PyTorch index; no submodule or credentials are needed.
Bootstrap: docker
From: python:3.12.12-slim-bookworm

%arguments
    ACCELERATOR=cu13
    # Minimum uv: 0.13.4 is the first release with the emSign CA fix (python.org announcement, Oct 20 2026).
    UV_MIN_VERSION=0.13.4

%files
    pyproject.toml /opt/rfd4/pyproject.toml
    README.md /opt/rfd4/README.md
    LICENSE /opt/rfd4/LICENSE
    .project-root /opt/rfd4/.project-root
    src /opt/rfd4/src
    configs /opt/rfd4/configs
    data/cath_label_mapping.pkl /opt/rfd4/data/cath_label_mapping.pkl
    data/benchmarks /opt/rfd4/data/benchmarks
    apptainer/smoke_test.py /opt/rfd4/smoke_test.py

%environment
    export PYTHONNOUSERSITE=1
    export TMOL_DISABLE_WHEEL_FETCH=1 TMOL_JIT_FALLBACK=0 TMOL_USE_JIT=0
    export DATA_PATH="${DATA_PATH:-/data}"
    export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"

%post
    set -eu
    export PIP_DISABLE_PIP_VERSION_CHECK=1 TMOL_DISABLE_WHEEL_FETCH=1 TMOL_JIT_FALLBACK=0 TMOL_USE_JIT=0
    ACCELERATOR="{{ ACCELERATOR }}"

    # build-essential: torch.compile (Inductor/Triton) compiles C++ and CUDA glue at run time.
    # The lib* packages are runtime dependencies of OpenBabel.
    # ca-certificates: makes sure the system CA bundle is the newest the distro offers.
    apt-get update
    apt-get install -y --no-install-recommends build-essential ca-certificates libxrender1 libx11-6 libxext6
    rm -rf /var/lib/apt/lists/*
    # Bootstrap trust (eMudhra/emSign CA incident, Oct 2026): the pip shipped in the base image bundles a
    # certifi that still trusts the compromised CA, and pip always trusts its bundled certifi in addition
    # to the system store. Install the fixed pip from a hash-pinned URL so this download is verified by
    # checksum rather than by the old trust store. Remove this step once the base image ships pip >= 26.2.2.
    python -m pip install --no-cache-dir "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70"
    python -m pip install --no-cache-dir "uv>={{ UV_MIN_VERSION }}"

    # Floor for certifi so no resolution can install a copy that trusts the compromised CA.
    # A constraint only applies if certifi is pulled in; it does not add the package.
    printf 'certifi>=2026.10.19\n' > /opt/rfd4-constraints.txt

    cd /opt/rfd4
    case "${ACCELERATOR}" in
        cu13) set -- --extra all-cuda13 --torch-backend cu130 ;;
        cu12) set -- --extra all-cuda12 --torch-backend cu126 ;;
        cpu) set -- --torch-backend cpu ;;
        *) echo "ACCELERATOR must be one of: cu13, cu12, cpu" >&2; exit 2 ;;
    esac
    uv pip install --system --no-cache --no-sources -c /opt/rfd4-constraints.txt \
        --only-binary tmol,tmol-ops-cu12,tmol-ops-cu13 "$@" -r pyproject.toml
    uv pip install --system --no-cache --no-sources --no-deps .
    if [ "${ACCELERATOR}" = "cpu" ]; then
        uv pip install --system --no-cache -c /opt/rfd4-constraints.txt --only-binary tmol "tmol>=0.2.0,<0.3" posebusters
    fi
    python -m pip check

    # Record the tool versions in the build log.
    uv --version
    python -m pip --version
    python -m pip list 2>/dev/null | grep -i '^certifi ' || true
    rm -f /opt/rfd4-constraints.txt

    # Smoke test: imports, TMol operators for the selected profile, Inductor, and the CLI.
    # A private TMPDIR keeps Inductor off any host /tmp directory that the build user does not own.
    mkdir -p /opt/rfd4-build-tmp
    ACCELERATOR="${ACCELERATOR}" TMPDIR=/opt/rfd4-build-tmp TORCHINDUCTOR_CACHE_DIR=/opt/rfd4-build-tmp/inductor \
        python /opt/rfd4/smoke_test.py
    rm -rf /opt/rfd4-build-tmp
    rfd4-generate --help > /dev/null
    mkdir -p /data /workspace

%runscript
    exec "$@"

%help
    RFD4-Proteina application image. Run with --nv for GPUs, for example:
      apptainer run --nv rfd4-proteina-cu13.sif rfd4-generate hf_ckpt_path=nvidia/RFD4-Proteina inputs=in.cif out_dir=./runs
    Bind your data and output directories with --bind; set HF_HOME to a writable cache (default: $HOME/.cache/huggingface).
