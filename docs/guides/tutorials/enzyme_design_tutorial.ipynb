     ]
    }
   ],
   "source": [
    "# ── Settings ─────────────────────────────────────────────────────\n",
    "NUM_DESIGNS = 25      # how many designs to sample\n",
    "BATCH_SIZE  = 5       # per-GPU batch size\n",
    "NSTEPS      = None    # diffusion steps; None keeps the config default\n",
    "GUIDANCE_W  = None    # guidance weight; None keeps the config default\n",
    "# ─────────────────────────────────────────────────────────────────\n",
    "\n",
    "ov2, name2 = [], f\"n{NUM_DESIGNS}\"\n",
    "if NSTEPS     is not None: ov2.append(f\"generation.args.nsteps={NSTEPS}\");        name2 += f\"_s{NSTEPS}\"\n",
    "if GUIDANCE_W is not None: ov2.append(f\"generation.args.guidance_w={GUIDANCE_W}\"); name2 += f\"_g{tag(GUIDANCE_W)}\"\n",
    "\n",
    "OUT2 = str(OUT_ROOT / f\"scaffold_{name2}\")\n",
    "csv2 = launch(OUT2, \"s2design\", theo, NUM_DESIGNS, ov2, BATCH_SIZE)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d2627ae0",
   "metadata": {},
   "source": [
    "### Results\n",
    "\n",
    "One row per design. `design_unindexed_motif_allatom_rmsd` measures how accurately the motif was\n",
    "placed and is computed without the refolding oracle, so it is deterministic; the refolded\n",
    "columns come from AF3 and carry the pass criteria."
   ]
