     "shell.execute_reply": "2026-07-21T17:17:02.046537Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "selected M0732_1xs1_theozyme_rep13: 4 of 25 designs passed, and this one places the motif most accurately (design_unindexed_motif_allatom_rmsd = 0.537 A)\n"
     ]
    },
    {
     "data": {
