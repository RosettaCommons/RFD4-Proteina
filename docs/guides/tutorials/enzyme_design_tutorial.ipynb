    "# ── Settings ─────────────────────────────────────────────────────\n",
    "PARTIAL_FRACTION = 0.5    # fraction of the trajectory to re-run; larger changes more\n",
    "PD_NUM_DESIGNS   = 10     # how many refined variants to generate\n",
    "# ─────────────────────────────────────────────────────────────────\n",
    "\n",
    "ov4 = [f\"generation.args.partial_trajectory_fraction_steps={PARTIAL_FRACTION}\"]\n",
    "OUT4 = str(OUT_ROOT / f\"partial_diffusion_frac{tag(PARTIAL_FRACTION)}_n{PD_NUM_DESIGNS}\")\n",
    "csv4 = launch(OUT4, \"s4partial\", best_cif, PD_NUM_DESIGNS, ov4, BATCH_SIZE)"
   ]
  },
