# Copy to .env.local. Exported shell settings take precedence.
# Use shell-compatible KEY=value assignments; quote paths containing spaces.
DATA_PATH=${PROJECT_ROOT}/data_path

# Optional mirrors, caches, and credentials; keep these in this ignored file.
# CCD_MIRROR_PATH=/path/to/ccd
# PDB_MIRROR_PATH=/path/to/pdb
# CACHE_DIR=/path/to/cache
# WANDB_API_KEY=...

# Optional refolding oracle, separate from the native model environment.
# AF3_IMAGE=/path/to/oracle.sif
# AF3_MODEL_DIR=/path/to/weights
# AF3_JAX_CACHE_DIR=/path/to/jax_cache
