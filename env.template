# Proteina Environment Variables
# Copy to .env and update paths: cp env.template .env
# Then train with: python proteinfoundation/train.py --config-name training_afdb_latents

# Base directory for training data (parquet files)
DATA_PATH=/path/to/your/data

# Cache directory for parsed structures
CACHE_DIR=/path/to/your/cache

# PDB mirror directory (optional, for PDB parsing)
PDB_MIRROR_PATH=/path/to/pdb/mirror

# CCD mirror directory (required for ligand parsing)
CCD_MIRROR_PATH=/path/to/ccd/mirror

# HBplus executable path (required for hydrogen bond analysis in design tasks)
# On DIGS, use: HBPLUS_PATH=/path/to/data
HBPLUS_PATH=/path/to/hbplus

# MolProbity script path (required for molprobity validation)
# On DIGS, use: MOLPROBITY_PATH=
MOLPROBITY_PATH=/path/to/molprobity

# MACE model path (required for MACE energy metric)
# On DIGS, use: MACE_MODEL_PATH=/mnt/path/to/data
MACE_MODEL_PATH=/path/to/mace/model.pt

# Foldseek executable path (required for foldseek clustering in evals)
# On DIGS, use: FOLDSEEK_EXEC=/software/foldseek/foldseek
FOLDSEEK_EXEC=/path/to/foldseek
# MSA directories (optional, comma-separated paths for multiple directories)
# If set, MSA features will be loaded and used for training
# Example: PROTEIN_MSA_DIRS=/path/to/msas/proteins,/path/to/more/msas
PROTEIN_MSA_DIRS=
RNA_MSA_DIRS=
