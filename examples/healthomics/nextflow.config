params {
    input_cif = null
    model_bundle = null
    settings = null
    container_image = null
    num_shards = 1
    generation_cpus = 8
    generation_accelerator = 'nvidia-l40s'
    outdir = 'results'
}

process {
    errorStrategy = 'terminate'
    time = '1h'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '--platform linux/amd64'
        process {
            withLabel: generation {
                containerOptions = '--gpus all'
            }
        }
    }
    healthomics {
        includeConfig 'conf/healthomics.config'
    }
}

manifest {
    name = 'RFD4-Proteina generation'
    description = 'Generate annotated structures from one annotated CIF with explicit seeds and a local model bundle.'
    nextflowVersion = '!25.10.0'
}
